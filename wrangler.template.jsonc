{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "sandbox-grapevine",
    "main": "worker/index.js",
    "compatibility_date": "2026-06-07",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }${WORKER_LIMITS_BLOCK},
    "vars": {
        "GRAPEVINE_DOMAIN": "${GRAPEVINE_DOMAIN}",
        "WEBAUTHN_RP_ID": "${WEBAUTHN_RP_ID}",
        "WEBAUTHN_RP_NAME": "${WEBAUTHN_RP_NAME}",
        "VAPID_PUBLIC_KEY": "${VAPID_PUBLIC_KEY}",
        "VAPID_SUBJECT": "${VAPID_SUBJECT}",
        "PUSH_DELIVERY_BATCH_SIZE": "${PUSH_DELIVERY_BATCH_SIZE}",
        "PUSH_DELIVERY_LIMIT": "${PUSH_DELIVERY_LIMIT}",
        "GRAPEVINE_TIMEZONE": "${GRAPEVINE_TIMEZONE}",
        "GRAPEVINE_SUMMARY_LOCAL_HOUR": "${GRAPEVINE_SUMMARY_LOCAL_HOUR}",
        "GRAPEVINE_SUMMARY_PERIOD_DAYS": "${GRAPEVINE_SUMMARY_PERIOD_DAYS}",
        "OPENROUTER_BASE_URL": "${OPENROUTER_BASE_URL}",
        "OPENROUTER_CHAT_COMPLETIONS_URL": "${OPENROUTER_CHAT_COMPLETIONS_URL}",
        "OPENROUTER_SUMMARY_MODEL": "${OPENROUTER_SUMMARY_MODEL}",
        "OPENROUTER_QUERY_MODEL": "${OPENROUTER_QUERY_MODEL}",
        "OPENROUTER_MAX_INPUT_MESSAGES": "${OPENROUTER_MAX_INPUT_MESSAGES}",
        "OPENROUTER_MAX_OUTPUT_TOKENS": "${OPENROUTER_MAX_OUTPUT_TOKENS}",
        "GRAPEVINE_MAX_SOURCE_MESSAGES": "${GRAPEVINE_MAX_SOURCE_MESSAGES}",
        "GRAPEVINE_MAX_SUMMARY_SOURCE_MESSAGES": "${GRAPEVINE_MAX_SUMMARY_SOURCE_MESSAGES}",
        "GRAPEVINE_MAX_CHUNKS": "${GRAPEVINE_MAX_CHUNKS}",
        "GRAPEVINE_AI_CONTEXT_MESSAGE_CHARACTERS": "${GRAPEVINE_AI_CONTEXT_MESSAGE_CHARACTERS}",
        "GRAPEVINE_MAX_MESSAGE_CHARACTERS": "${GRAPEVINE_MAX_MESSAGE_CHARACTERS}",
        "GRAPEVINE_MAX_QUESTION_CHARACTERS": "${GRAPEVINE_MAX_QUESTION_CHARACTERS}",
        "GRAPEVINE_MAX_FILTER_IDS": "${GRAPEVINE_MAX_FILTER_IDS}",
        "GRAPEVINE_DAILY_RECORDING_MINUTES": "${GRAPEVINE_DAILY_RECORDING_MINUTES}",
        "GRAPEVINE_DAILY_MESSAGE_LIMIT": "${GRAPEVINE_DAILY_MESSAGE_LIMIT}",
        "GRAPEVINE_DAILY_QUESTION_LIMIT": "${GRAPEVINE_DAILY_QUESTION_LIMIT}",
        "WORKERS_AI_TRANSCRIPTION_MODEL": "${WORKERS_AI_TRANSCRIPTION_MODEL}",
        "WORKERS_AI_TRANSCRIPTION_LANGUAGE": "${WORKERS_AI_TRANSCRIPTION_LANGUAGE}",
        "WORKERS_AI_TRANSCRIPTION_INITIAL_PROMPT": "${WORKERS_AI_TRANSCRIPTION_INITIAL_PROMPT}",
        "WORKERS_AI_TRANSCRIPTION_MAX_AUDIO_BYTES": "${WORKERS_AI_TRANSCRIPTION_MAX_AUDIO_BYTES}",
        "WORKERS_AI_TRANSCRIPTION_MIN_SECONDS_PER_MEGABYTE": "${WORKERS_AI_TRANSCRIPTION_MIN_SECONDS_PER_MEGABYTE}",
        "SESSION_TTL_DAYS": "${SESSION_TTL_DAYS}",
        "DATA_RETENTION_POLICY": "${DATA_RETENTION_POLICY}",
        "LOG_LEVEL": "${LOG_LEVEL}",
        "CBOR_NATIVE_ACCELERATION_DISABLED": "true"
    },
    "ai": {
        "binding": "AI"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "${D1_DATABASE_NAME}",
            "database_id": "${D1_DATABASE_ID}",
            "migrations_dir": "worker/migrations"
        }
    ],
    "triggers": {
        "crons": [
            "${GRAPEVINE_SUMMARY_CRON}"
        ]
    }
}
