{
  "name": "gratis-grapevine",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint --fix src worker scripts tests vite.config.js playwright.config.js",
    "lint:check": "eslint src worker scripts tests vite.config.js playwright.config.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "deploy:config": "node scripts/render_deploy_config.js",
    "db:migrate:local": "wrangler d1 migrations apply gratis-grapevine --local --config wrangler.generated.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply gratis-grapevine --remote --config wrangler.generated.jsonc",
    "admin:bootstrap": "node scripts/bootstrap_admin.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "city-timezones": "^1.3.4",
    "less-lazy": "^0.0.2",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.0",
    "mentie": "^0.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "react-router": "^7.0.0",
    "styled-components": "^6.1.13",
    "use-query-params": "^2.2.1",
    "vite-plugin-pwa": "^0.21.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-react": "^4.3.4",
    "airier": "^0.1.1",
    "husky": "^9.1.7",
    "vite": "^6.0.0",
    "wrangler": "^3.95.0"
  }
}
